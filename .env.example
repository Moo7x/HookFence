# ---------------------------------------------------------------------------
# HookFence environment. Copy to .env and fill in. NEVER commit .env.
# NEVER paste a private key into a chat window or issue tracker.
# Prefer a dedicated throwaway testnet wallet, or use `cast wallet` keystores.
# ---------------------------------------------------------------------------

# --- RPC endpoints (public endpoints work; no API key required) -------------
ROBINHOOD_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc

# --- Fork pinning (reproducible baseline evidence) --------------------------
# Leave empty to fork at latest; set to pin results.
FORK_BLOCK_ROBINHOOD_MAINNET=

# --- Deployer key -----------------------------------------------------------
# Option A (preferred): use a keystore instead of a raw key.
#   cast wallet import hookfence-deployer --interactive
#   forge script ... --account hookfence-deployer
# Option B: raw key in this file only (0x-prefixed). Dedicated testnet wallet only.
PRIVATE_KEY=

# --- Verification -----------------------------------------------------------
BLOCKSCOUT_TESTNET_URL=https://explorer.testnet.chain.robinhood.com/api
BLOCKSCOUT_MAINNET_URL=https://robinhoodchain.blockscout.com/api
